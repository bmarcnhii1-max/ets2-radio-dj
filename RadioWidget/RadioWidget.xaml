<Page
    x:Class="RadioWidget.RadioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FF121212">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,12">

                <!-- ШАПКА -->
                <Border Padding="10,8" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#FF1DB954">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="17" Foreground="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="ETS2 RADIO DJ" FontSize="12" FontWeight="ExtraBold" Foreground="#FFFFFFFF"/>
                            <TextBlock x:Name="AccountText" Text="Профиль: ..." FontSize="9" FontWeight="SemiBold" Foreground="#FF1DB954" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="● LIVE" FontSize="9" FontWeight="Bold" Foreground="#FF1DB954" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ВКЛАДКИ -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- UWP-кнопка рисует строковый контент слева: TextBlock с
                         TextAlignment=Center; Stretch обязателен — иначе кнопка
                         сжимается до размера текста и липнет влево -->
                    <Button x:Name="TabPlayerBtn" Click="TabPlayer_Click" Height="26" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#FFFFFFFF" Foreground="#FF000000" BorderThickness="0" FontSize="10" FontWeight="Bold">
                        <TextBlock Text="Плеер" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="1" x:Name="TabQueueBtn" Click="TabQueue_Click" Height="26" Padding="0" Margin="4,0,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#FF242424" Foreground="#FFC4C8D0" BorderThickness="0" FontSize="10" FontWeight="Bold">
                        <TextBlock Text="Очередь" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="2" x:Name="TabRadioBtn" Click="TabRadio_Click" Height="26" Padding="0" Margin="4,0,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#FF242424" Foreground="#FFC4C8D0" BorderThickness="0" FontSize="10" FontWeight="Bold">
                        <TextBlock Text="Радио" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="3" x:Name="TabSearchBtn" Click="TabSearch_Click" Height="26" Padding="0" Margin="4,0,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#FF242424" Foreground="#FFC4C8D0" BorderThickness="0" FontSize="10" FontWeight="Bold">
                        <TextBlock Text="Поиск" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- ================= ВКЛАДКА ПЛЕЕР ================= -->
                <StackPanel x:Name="PlayerPanel" Margin="0,8,0,0">

                    <Border Padding="10,9" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="10" Background="#FF242424" Margin="0,0,10,0">
                                <Grid>
                                    <Image x:Name="AlbumArt" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    <FontIcon x:Name="AlbumArtFallback" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="24" Foreground="#FF1DB954" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="BadgeText" Text="В ЭФИРЕ" FontSize="8" FontWeight="SemiBold" Foreground="#FF1DB954"/>
                                <TextBlock x:Name="TitleText" Text="ETS2 Radio DJ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,1"/>
                                <TextBlock x:Name="ArtistText" Text="..." FontSize="10" Foreground="#FFC4C8D0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SEEK -->
                    <Border Margin="0,7,0,0" Padding="10,6" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <Grid x:Name="SeekVisual" Height="22" SizeChanged="SeekVisual_SizeChanged">
                                <!-- Ручная полоса прогресса: новый UWP ProgressBar
                                     не масштабирует PART_Indicator из кастомного шаблона -->
                                <Grid Height="6" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border Background="#22FFFFFF" CornerRadius="3"/>
                                    <Border x:Name="SeekFill" HorizontalAlignment="Left" Width="0" Background="#FF1DB954" CornerRadius="3"/>
                                </Grid>
                                <Grid x:Name="SeekThumb" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse Width="14" Height="14" Fill="#331DB954"/>
                                    <Ellipse Width="8" Height="8" Fill="#FF1DB954" Stroke="#FFFFFFFF" StrokeThickness="1"/>
                                </Grid>
                                <Slider x:Name="SeekSlider" Minimum="0" Maximum="180" Value="0" StepFrequency="1" Margin="0" Height="22"
                                        Opacity="0" IsHitTestVisible="True" IsThumbToolTipEnabled="False"
                                        ValueChanged="SeekSlider_ValueChanged" PointerPressed="SeekSlider_PointerPressed" PointerCaptureLost="SeekSlider_PointerCaptureLost"/>
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="9" FontFamily="Consolas" Foreground="#FFC4C8D0"/>
                                <TextBlock x:Name="DurationText" Text="0:00" HorizontalAlignment="Right" FontSize="9" FontFamily="Consolas" Foreground="#FFC4C8D0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ГРОМКОСТЬ -->
                    <Border Margin="0,7,0,0" Padding="10,6" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="12" Foreground="#FFC4C8D0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ГРОМКОСТЬ" FontSize="8" FontWeight="Bold" Foreground="#FFC4C8D0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="VolumeLabel" Text="100%" HorizontalAlignment="Right" FontSize="10" FontFamily="Consolas" Foreground="#FF1DB954"/>
                            </Grid>
                            <Grid x:Name="VolumeVisual" Height="20" Margin="0,2,0,0" SizeChanged="VolumeVisual_SizeChanged">
                                <Grid Height="6" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border Background="#22FFFFFF" CornerRadius="3"/>
                                    <Border x:Name="VolumeFill" HorizontalAlignment="Left" Width="0" Background="#FF1DB954" CornerRadius="3"/>
                                </Grid>
                                <Grid x:Name="VolumeThumb" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse Width="12" Height="12" Fill="#331DB954"/>
                                    <Ellipse Width="8" Height="8" Fill="#FF1DB954" Stroke="#FFFFFFFF" StrokeThickness="1"/>
                                </Grid>
                                <Slider x:Name="VolumeSlider" Minimum="50" Maximum="160" Value="100" StepFrequency="5"
                                        Height="20" Opacity="0" IsThumbToolTipEnabled="False"
                                        ValueChanged="VolumeSlider_ValueChanged"
                                        PointerPressed="VolumeSlider_PointerPressed" PointerCaptureLost="VolumeSlider_PointerCaptureLost"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ТРАНСПОРТ -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="PrevBtn" Click="Prev_Click" Width="38" Height="38" Padding="0" Margin="2"
                                Background="#FF242424" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE892;" FontSize="14" Foreground="#FFFFFFFF"/>
                        <Button x:Name="RewindBtn" Click="Rewind_Click" Width="42" Height="38" Padding="0" Margin="2"
                                Background="#FF242424" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe UI" Content="-15" FontSize="10" Foreground="#FFFFFFFF"/>
                        <Button x:Name="PlayBtn" Click="PlayPause_Click" Width="48" Height="38" Padding="0" Margin="2"
                                Background="#FF1DB954" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE769;" FontSize="16" Foreground="#FF000000"/>
                        <Button x:Name="LikeBtn" Click="Like_Click" Width="38" Height="38" Padding="0" Margin="2"
                                Background="#FF242424" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE734;" FontSize="15" Foreground="#FF1DB954"
                                ToolTipService.ToolTip="Лайк в аккаунт"/>
                        <Button x:Name="FwdBtn" Click="Forward_Click" Width="42" Height="38" Padding="0" Margin="2"
                                Background="#FF242424" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe UI" Content="+15" FontSize="10" Foreground="#FFFFFFFF"/>
                        <Button x:Name="NextBtn" Click="Next_Click" Width="38" Height="38" Padding="0" Margin="2"
                                Background="#FF242424" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE893;" FontSize="14" Foreground="#FFFFFFFF"/>
                        <Button x:Name="DislikeBtn" Click="Dislike_Click" Width="38" Height="38" Padding="0" Margin="2"
                                Background="#FF242424" BorderThickness="0" CornerRadius="6"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE8E0;" FontSize="15" Foreground="#FFFF6F6F"
                                ToolTipService.ToolTip="Не нравится — заменить трек"/>
                    </StackPanel>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PlaylistCombo" PlaceholderText="Выбери плейлист YT..." Height="28"
                                  HorizontalAlignment="Stretch" Background="#FF242424" Foreground="#FFFFFFFF"
                                  BorderThickness="0" FontSize="10"/>
                        <Button Grid.Column="1" x:Name="PlayPlaylistBtn" Click="PlayPlaylist_Click" Margin="5,0,0,0"
                                Height="28" Padding="10,0" Background="#FF1DB954" Foreground="#FF000000"
                                BorderThickness="0" FontWeight="Bold" FontSize="10" Content="Играть"/>
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Click="PlayLikes_Click" Content="Лайки" Height="25" Padding="9,0" Margin="0,0,4,0"
                                Background="#FF242424" Foreground="#FFFFFFFF" BorderThickness="0" FontSize="9"/>
                        <Button Grid.Column="1" Click="PlayRemix_Click" Content="Remix" Height="25" Padding="9,0" Margin="0,0,4,0"
                                Background="#FF242424" Foreground="#FFFFFFFF" BorderThickness="0" FontSize="9"/>
                        <Button Grid.Column="2" Click="OpenUI_Click" Content="Web UI" Height="25" Padding="9,0"
                                Background="#FF242424" Foreground="#FFFFFFFF" BorderThickness="0" FontSize="9"/>
                        <TextBlock Grid.Column="3" x:Name="CacheText" Text="" Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontSize="8" Foreground="#FF7A7F8A" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>

                <!-- ================= ВКЛАДКА ОЧЕРЕДЬ ================= -->
                <StackPanel x:Name="QueuePanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border Padding="10,7" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="ОЧЕРЕДЬ В ЭФИРЕ" FontSize="9" FontWeight="Bold" Foreground="#FFC4C8D0"/>
                            <TextBlock x:Name="QueueCountText" Text="0" HorizontalAlignment="Right" FontSize="9" Foreground="#FF1DB954"/>
                        </Grid>
                    </Border>
                    <ScrollViewer MaxHeight="400" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QueueListPanel"/>
                    </ScrollViewer>
                    <TextBlock x:Name="QueueEmptyText" Text="Очередь пуста — выбери трек во вкладке Поиск или в Подборках Web UI"
                               FontSize="10" Foreground="#FF7A7F8A" TextWrapping="Wrap" Margin="2,10,2,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ================= ВКЛАДКА РАДИО ================= -->
                <StackPanel x:Name="RadioPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border Padding="10,7" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="ИНТЕРНЕТ-РАДИО" FontSize="9" FontWeight="Bold" Foreground="#FFC4C8D0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="RadioHealthText" Text="" FontSize="8" Foreground="#FF7A7F8A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="StopStationBtn" Click="StopStation_Click" Content="Стоп" Height="22" Padding="8,0"
                                        Background="#FF242424" Foreground="#FFFF6F6F" BorderThickness="0" FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="TeleCard" Padding="10,6" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,7,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TeleSpeedText" Text="0" FontSize="22" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF1DB954"/>
                            <TextBlock Text=" км/ч" FontSize="10" Foreground="#FFC4C8D0" VerticalAlignment="Bottom" Margin="2,0,12,3"/>
                            <TextBlock x:Name="TeleGearText" Text="N" FontSize="12" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text=" топл. " FontSize="9" Foreground="#FF7A7F8A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TeleFuelText" Text="—" FontSize="11" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TelePausedText" Text="ПАУЗА" FontSize="9" Foreground="#FFF5A623" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer MaxHeight="420" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StationsListPanel"/>
                    </ScrollViewer>
                </StackPanel>

                <!-- ================= ВКЛАДКА ПОИСК ================= -->
                <StackPanel x:Name="SearchPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border Padding="10,7" CornerRadius="10" Background="#FF181818" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" PlaceholderText="Название трека или ссылка..." KeyDown="SearchBox_KeyDown"
                                     Height="28" FontSize="10" Background="#FF242424" Foreground="#FFFFFFFF" BorderThickness="0"/>
                            <Button Grid.Column="1" Click="SearchNow_Click" Margin="5,0,0,0" Width="34" Height="28" Padding="0"
                                    Background="#FF1DB954" Foreground="#FF000000" BorderThickness="0"
                                    FontFamily="Segoe MDL2 Assets" Content="&#xE721;" FontSize="12"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SearchStatusText" Text="" FontSize="9" Foreground="#FF7A7F8A" Margin="2,6,2,0"/>
                    <ScrollViewer MaxHeight="420" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SearchResultsPanel"/>
                    </ScrollViewer>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
